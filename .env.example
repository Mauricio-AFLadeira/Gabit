# Aplicação
APP_ENV=development

# Toolchain
# Versão do Swift da imagem Docker. Mantenha em sincronia com .swift-version
# e com a versão que o Xcode usa no macOS.
SWIFT_VERSION=6.3.3

# Dono dos arquivos criados dentro do container. `make setup` preenche isso
# automaticamente no Linux; no macOS o Docker Desktop já cuida do mapeamento.
HOST_UID=1000
HOST_GID=1000

# SwiftLint não tem binário pré-compilado para Linux: ligar isso compila a
# ferramenta durante o build da imagem e acrescenta alguns minutos ao primeiro
# `make setup`. O swift-format do toolchain já roda sem isso.
WITH_SWIFTLINT=0
SWIFTLINT_VERSION=0.65.1

# Postgres (serviço `db` do compose)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=mauit
DATABASE_PASSWORD=mauit
DATABASE_NAME=mauit

# Roda as migrations automaticamente ao subir o servidor. Conveniente em dev;
# desligue em qualquer ambiente mais próximo de produção e rode
# `make migrate` como passo separado.
AUTO_MIGRATE=true

# Assina os tokens JWT emitidos por /auth/register e /auth/login. Troque por
# um valor forte fora do ambiente local.
JWT_SECRET=insecure-dev-secret-change-me
