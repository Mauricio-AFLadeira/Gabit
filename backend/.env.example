# Copy to .env for local overrides — docker-compose.yml already sets these
# to match its own `db` service, so this mostly matters for running the
# backend outside Docker (`npm run dev --workspace=@mauit/backend`).

DATABASE_URL=postgresql://mauit:mauit@localhost:5432/mauit
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
