generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  goal           Goal?
  entries        Entry[]
  weightCheckIns WeightCheckIn[]

  @@map("users")
}

/// One row per user — a `PUT /api/goal` replaces it rather than appending
/// history. `direction` stores a `GoalDirection` from @mauit/shared, so the
/// server hands it straight to `dailyTarget()` instead of keeping its own
/// copy of that formula.
model Goal {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction           String
  ratePerWeek         Float    @map("rate_per_week")
  maintenanceCalories Int      @map("maintenance_calories")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("goals")
}

/// A logged meal or a manual burn. `kind` is either a MealType
/// ("breakfast"/"lunch"/"dinner"/"snack") or the literal "exercise"; the
/// three macro fields are null exactly when kind is "exercise".
model Entry {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  calories     Int
  proteinGrams Int?     @map("protein_grams")
  carbsGrams   Int?     @map("carbs_grams")
  fatGrams     Int?     @map("fat_grams")
  loggedAt     DateTime @map("logged_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, loggedAt])
  @@map("entries")
}

model WeightCheckIn {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kg         Float
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, recordedAt])
  @@map("weight_check_ins")
}
